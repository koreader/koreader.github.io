msgctxt "user_guide/en.html+tips.ul.li:112--5"
msgid "Adding a password lock"
msgstr "Engadir un bloqueo con contrasinal"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7431-1
msgctxt "user_guide/en.html+tips.ul.li:113--5"
msgid "Controlling KOReader from another device"
msgstr "Controlar KOReader dende outro dispositivo"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7432-1
msgctxt "user_guide/en.html+tips.ul.li:114--5"
msgid "Automatic screen dimming"
msgstr "Atenuación automática da pantalla"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7433-1
msgctxt "user_guide/en.html+tips.ul.li:115--5"
