"{ document.body.classList.add('dark'); themeSwitcher.checked = true; } "
"themeSwitcher.addEventListener('change', function() "
"{ document.body.classList.toggle('dark'); localStorage.setItem('theme', "
"this.checked ? 'dark' : 'light'); }); });"
