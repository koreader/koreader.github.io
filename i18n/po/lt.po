"pateikiama susijusiuose šio vadovo skyriuose."

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:2172-7
#| msgid ""
#| "<span class=\"ui\">NAVIGATION:</span> This menu contains items that "
#| "allows you to navigate the book you are currently reading. <b>Table of "
#| "contents, bookmarks, book map...</b>"
msgid ""
