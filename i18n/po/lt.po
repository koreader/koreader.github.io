#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6658-10
msgctxt "user_guide/en.html+qmandprofiles.table.tr.td.ul.li:313-4"
msgid "Combined with <b>book metadata</b>"
msgstr "Derinama su <b>knygos metaduomenimis</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6659-10
msgctxt "user_guide/en.html+qmandprofiles.table.tr.td.ul.li:314-4"
msgid "Combined with <b>book file path</b>"
msgstr "Derinama su <b>knygos failo keliu</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6660-10
msgctxt "user_guide/en.html+qmandprofiles.table.tr.td.ul.li:315-4"
msgid "Combined with <b>collections book is included in</b>"
msgstr "Derinama su <b>rinkiniais, į kuriuos įtraukta knyga</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6661-10
msgid "Combined with <b>book is being opened for the first time</b>"
msgstr "Derinama su <b>knyga atveriama pirmą kartą</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td:6667-8
msgid "On book closing"
msgstr "Uždarant knygą"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.p:6668-8
msgid ""
"This option is same as above but it triggers when you close a book. You can "
"use this for example enabling/disabling reading statistics when you open "
"certain documents to exclude them from your stats."
msgstr ""
"Ši parinktis tokia pati kaip aukščiau, bet aktyvuojama uždarius knygą. Tai "
"galite naudoti, pavyzdžiui, įjungiant/išjungiant skaitymo statistiką "
"atveriant tam tikrus dokumentus, kad neįtrauktumėte jų į statistiką."

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6671-10
msgctxt "user_guide/en.html+qmandprofiles.table.tr.td.ul.li:326-4"
msgid "Combined with <b>device orientation</b>"
msgstr "Derinama su <b>įrenginio orientacija</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6672-10
msgctxt "user_guide/en.html+qmandprofiles.table.tr.td.ul.li:327-4"
msgid "Combined with <b>book metadata</b>"
msgstr "Derinama su <b>knygos metaduomenimis</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6673-10
msgctxt "user_guide/en.html+qmandprofiles.table.tr.td.ul.li:328-4"
msgid "Combined with <b>book file path</b>"
msgstr "Derinama su <b>knygos failo keliu</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6674-10
msgctxt "user_guide/en.html+qmandprofiles.table.tr.td.ul.li:329-4"
msgid "Combined with <b>collections book is included in</b>"
msgstr "Derinama su <b>rinkiniais, į kuriuos įtraukta knyga</b>"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td:6680-8
msgid "On read timer expiry"
msgstr ""

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.p:6681-8
#, fuzzy
#| msgid "Run this profile every time device wakes up"
msgid "Run this profile every time the read timer finishes"
