#~ msgid "FONT WEIGHT"
#~ msgstr "ŠRIFTO SVORIS"

#~ msgid ""
#~ "<span class=\"ui\">Font hinting</span> adjusts your text for maximum "
#~ "readability according to your screen’s pixel grid. <span "
#~ "class=\"ui\">native</span> uses font’s internal hinting instructions, "
#~ "<span class=\"ui\">auto</span> uses FreeType’s hinting algorithm. <span "
#~ "class=\"ui\">auto</span> is a safer choice because font files that you "
#~ "installed may have problematic hinting instructions. Also <span "
#~ "class=\"ui\">auto</span> handles <b>CJK</b> text better. You can try "
#~ "different settings to see which one looks better on your device."
#~ msgstr ""
#~ "<span class=\"ui\">Šrifto instrukcijos (hinting)</span> koreguoja tekstą "
#~ "maksimaliam skaitomumui pagal jūsų ekrano pikselių tinklelį. <span "
#~ "class=\"ui\">native</span> naudoja šrifto vidines instrukcijas, <span "
#~ "class=\"ui\">auto</span> naudoja „FreeType“ instrukcijų algoritmą. <span "
#~ "class=\"ui\">auto</span> yra saugesnis pasirinkimas, nes jūsų įdiegti "
#~ "šriftų failai gali turėti probleminių instrukcijų. Taip pat <span "
#~ "class=\"ui\">auto</span> geriau tvarko <b>CJK</b> (kinų/japonų/"
#~ "korėjiečių) tekstą. Galite išbandyti skirtingus nustatymus, kad "
#~ "pamatytumėte, kuris geriau atrodo jūsų įrenginyje."

