#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7430-1
msgctxt "user_guide/en.html+tips.ul.li:112--5"
msgid "Adding a password lock"
msgstr "Додавање лозинке за закључавање KOReader читача"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7431-1
msgctxt "user_guide/en.html+tips.ul.li:113--5"
