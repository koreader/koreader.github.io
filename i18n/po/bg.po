"<span class=\"ui\">If folder path does not contain</span> a certain text"
msgstr ""
"<span class=\"ui\">Ако пътят на папката не съдържа</span> определен текст"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.table.tr.td.ul.li:6643-9
#, fuzzy
#| msgid "<span class=\"ui\">If folder path contains</span> a certain text"
