#~ msgstr "YAZI TİPİ AĞIRLIĞI"

#~ msgid ""
#~ "<span class=\"ui\">Font hinting</span> adjusts your text for maximum "
#~ "readability according to your screen’s pixel grid. <span "
#~ "class=\"ui\">native</span> uses font’s internal hinting instructions, "
#~ "<span class=\"ui\">auto</span> uses FreeType’s hinting algorithm. <span "
#~ "class=\"ui\">auto</span> is a safer choice because font files that you "
#~ "installed may have problematic hinting instructions. Also <span "
#~ "class=\"ui\">auto</span> handles <b>CJK</b> text better. You can try "
#~ "different settings to see which one looks better on your device."
#~ msgstr ""
#~ "<span class=\"ui\">Yazı tipi hinting</span>, metninizi ekranınızın piksel "
#~ "ızgarasına göre maksimum okunurluk için ayarlar. <span "
#~ "class=\"ui\">native</span>, yazı tipinin dahili hinting talimatlarını "
#~ "kullanırken <span class=\"ui\">auto</span>, FreeType'ın hinting "
#~ "algoritmasını kullanır. <span class=\"ui\">auto</span> daha güvenli bir "
#~ "seçimdir çünkü yüklediğiniz yazı tipi dosyaları sorunlu hinting "
#~ "talimatlarına sahip olabilir. Ayrıca <span class=\"ui\">auto</span>, "
#~ "<b>CJK</b> metnini daha iyi işler. Cihazınızda hangisinin daha iyi "
#~ "göründüğünü görmek için farklı ayarları deneyebilirsiniz."

