msgid ""
"TOP MENU / <img class=\"img_inline\" src=\"pictures/top_bookmark.svg\" "
"style=\"width:26px;\"> / Bookmarks"
msgstr ""
"顶部菜单 / <img class=\"img_inline\" src=\"pictures/top_bookmark.svg\" "
"style=\"width:22px;\"> / 书籍地图"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.p:2736-6
#, fuzzy
#| msgid ""
#| "You can start the search from your library <span class=\"ui\">Home "
#| "folder</span> or your <span class=\"ui\">Current folder</span> by "
#| "pressing on the respective button."
