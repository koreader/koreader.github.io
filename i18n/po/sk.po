#, fuzzy
#| msgctxt "user_guide/en.html+html.body.div.ol.li:3491-9"
#| msgid ""
#| "Go to the <span class=\"ui\">Collections</span> screen that is seen in "
#| "the image above."
msgctxt "user_guide/en.html+managinglibrary.ol.li:445-1"
msgid ""
"Go to the <span class=\"ui\">Collections</span> screen that is seen in the "
"image above."
msgstr ""
"Prejdite na obrazovku <span class=\"ui\">Zbierky</span>, ktorá je zobrazená "
"na obrázku vyššie."

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ol.li:5083-7
#, fuzzy
#| msgctxt "user_guide/en.html+html.body.div.ol.li:3492-9"
#| msgid ""
#| "Long-press on the collection name which you want to connect folders "
#| "<b>(1)</b>."
msgctxt "user_guide/en.html+managinglibrary.ol.li:447-1"
msgid ""
"Long-press on the collection name which you want to connect folders <b>(1)</"
"b>."
msgstr ""
"Dlho stlačte názov zbierky, ku ktorej chcete priečinky prepojiť <b>(1)</b>."

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ol.li:5084-7
#, fuzzy
#| msgctxt "user_guide/en.html+html.body.div.ol.li:3493-9"
#| msgid ""
#| "Select <span class=\"ui\">Connect folders</span> from the pop-up menu "
#| "<b>(2)</b>."
msgctxt "user_guide/en.html+managinglibrary.ol.li:448-1"
msgid ""
"Select <span class=\"ui\">Connect folders</span> from the pop-up menu "
"<b>(2)</b>."
msgstr ""
"V rozbaľovacej ponuke <b>(2)</b> vyberte možnosť <span class=\"ui\">Pripojiť "
"priečinky</span>."

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ol.li:5086-7
#, fuzzy
#| msgctxt "user_guide/en.html+html.body.div.ol.li:3494-9"
#| msgid ""
#| "<span class=\"ui\">List of connected folders screen</span> will open."
