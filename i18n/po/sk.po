#: user_guide/en.html%2Bhtml.body.div.main.div.section.p:2726-6
#, fuzzy
#| msgid ""
#| "You can add (and remove) a bookmark by pressing the upper right corner. "
#| "This is the equivalent of folding the corner of a page on a real book and "
