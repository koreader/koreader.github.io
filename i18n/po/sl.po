"koli razloga ni v meniju, ga lahko omogočiš tukaj:"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.div:1803-6
msgid ""
"TOP MENU / <img class=\"img_inline\" src=\"pictures/top_tools.svg\" "
"style=\"width:22px;\"> / More tools / Auto Warmth and Night Mode"
msgstr ""
"ZGORNJI MENI / <img class=\"img_inline\" src=\"pictures/top_tools.svg\" "
"style=\"width:22px;\"> / Več orodij / Samodejna toplina in nočni način"

