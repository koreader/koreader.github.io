#~ msgid ""
#~ "<span class=\"ui\">Font hinting</span> adjusts your text for maximum "
#~ "readability according to your screen’s pixel grid. <span "
#~ "class=\"ui\">native</span> uses font’s internal hinting instructions, "
#~ "<span class=\"ui\">auto</span> uses FreeType’s hinting algorithm. <span "
#~ "class=\"ui\">auto</span> is a safer choice because font files that you "
#~ "installed may have problematic hinting instructions. Also <span "
#~ "class=\"ui\">auto</span> handles <b>CJK</b> text better. You can try "
#~ "different settings to see which one looks better on your device."
#~ msgstr ""
#~ "<span class=\"ui\">Namigovanje pisave</span> prilagodi tvoje besedilo za "
#~ "največjo berljivost glede na mrežo slikovnih pik tvojega zaslona. <span "
#~ "class=\"ui\">native</span> uporablja notranja navodila za namigovanje "
#~ "pisave, <span class=\"ui\">auto</span> pa uporablja algoritem za "
#~ "namigovanje FreeType. <span class=\"ui\">auto</span> je varnejša izbira, "
#~ "ker imajo nameščene datoteke pisav lahko problematična navodila za "
#~ "namigovanje. Prav tako <span class=\"ui\">auto</span> bolje obravnava "
#~ "besedilo <b>CJK</b>. Lahko poskusiš z različnimi nastavitvami, da vidiš, "
#~ "katera je v tvoji napravi videti bolje."

