msgid "Checking battery consumption details"
msgstr "Consultar els detalls del consum de la bateria"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7435-1
msgctxt "user_guide/en.html+tips.ul.li:117--5"
msgid "Checking detailed device statistics"
msgstr "Consultar estadístiques detallades del dispositiu"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7436-1
