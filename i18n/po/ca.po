"Controlar el lector des d'un altre dispositiu - Complement HTTP Inspector"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7432-1
msgctxt "user_guide/en.html+tips.ul.li:114--5"
msgid "Automatic screen dimming"
msgstr "Atenuació automàtica de la pantalla"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7433-1
msgctxt "user_guide/en.html+tips.ul.li:115--5"
msgid "Optimizing battery health"
msgstr "Optimitzar la durada de la bateria"

#: user_guide/en.html%2Bhtml.body.div.main.div.section.ul.li:7434-1
